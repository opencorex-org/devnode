<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="devnode-desktop"
        Arguments=""
        InstallLocation="C:\Program Files\DevNode\DevNode">
    </Installer>
    <PackageInformation
        PackageName="DevNode"
        PackageDisplayName="DevNode"
        PublisherName="CN=DevNode"
        PublisherDisplayName="DevNode"
        Version="0.1.0.0"
        PackageDescription="Cross-platform Ubuntu development server manager">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.lahiruudayakumara.devnode"
                Description="Cross-platform Ubuntu development server manager"
                DisplayName="DevNode"
                ExecutableName="devnode-desktop"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>DevNode</DisplayName>
            <PublisherDisplayName>DevNode</PublisherDisplayName>
            <Description>Cross-platform Ubuntu development server manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="devnode.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
